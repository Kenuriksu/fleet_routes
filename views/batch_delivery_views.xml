<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- LIST VIEW -->
<record id="view_batch_delivery_list" model="ir.ui.view">
    <field name="name">batch.delivery.list</field>
    <field name="model">batch.delivery</field>
    <field name="arch" type="xml">
        <list default_group_by="route_id">
            <field name="name"/>
            <field name="city"/>
            <field name="delivery_date"/>
            <field name="route_id"/>
            <field name="model_id"/>
            <field name="order_ids"/>
            <field name="state"/>
        </list>
    </field>
</record>

<!-- FORM VIEW -->
<record id="view_batch_delivery_form" model="ir.ui.view">
    <field name="name">batch.delivery.form</field>
    <field name="model">batch.delivery</field>
    <field name="arch" type="xml">
        <form string="Route">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="route_id"/>
                    <field name="delivery_date"/>
                    <field name="city"/>
                    <field name="order_ids"/>
                    <field name="model_id"/>
                    <field name="state"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- ACTION -->
<record id="action_batch_deliveries" model="ir.actions.act_window">
    <field name="name">Batch Deliveries</field>
    <field name="res_model">batch.delivery</field>
    <field name="view_mode">list,form</field>
</record>


</odoo>
