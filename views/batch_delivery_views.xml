<record id="view_batch_delivery_list" model="ir.ui.view">
    <field name="name">batch.delivery.list</field>
    <field name="model">batch.delivery</field>
    <field name="arch" type="xml">
        <list default_group_by="route_id">
            <field name="name"/>
            <field name="city"/>
            <field name="delivery_date"/>
            <field name="route_id"/>
            <field name="truck_id"/>
            <field name="state"/>
        </list>
    </field>
</record>